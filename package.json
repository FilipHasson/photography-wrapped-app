{
  "name": "photography-wrapped-app",
  "version": "0.1.0",
  "private": true,
  "description": "Scan a photography library and turn it into a deck of stats slides — favourite lens, favourite body, favourite camera+lens combo, and the rest of the year in frames.",
  "type": "module",
  "productName": "Photography Wrapped",
  "main": "electron/main.ts",
  "engines": {
    "node": ">=24.0.0"
  },
  "bin": {
    "photography-wrapped": "src/cli.ts",
    "wrapped": "src/cli.ts"
  },
  "scripts": {
    "dev": "node --watch --disable-warning=ExperimentalWarning src/cli.ts --port 4112 --no-open",
    "start": "node --disable-warning=ExperimentalWarning src/cli.ts",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "clean": "node -e \"for (const p of ['dist', 'build', 'fixtures', 'tmp']) require('node:fs').rmSync(p, { recursive: true, force: true })\"",
    "app": "npm run icon --silent && electron .",
    "app:smoke": "npm run icon --silent && electron electron/smoke.ts",
    "icon": "node tools/make-icon.ts build/icon.ico",
    "package": "npm run icon --silent && electron-packager . --overwrite --out=dist --asar --icon=build/icon.ico --app-copyright=\"Filip Hasson\" --ignore=\"^/(test|tools|dist|fixtures|tmp|out|\\.github|\\.claude)($|/)\" --ignore=\"^/build/smoke\" --ignore=\"^/(tsconfig|CLAUDE)\\.\"",
    "fixtures": "node tools/make-fixtures.ts"
  },
  "dependencies": {
    "exifr": "^7.1.3"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/node": "^24.0.0",
    "electron": "^43.4.1",
    "typescript": "^5.7.0"
  }
}
